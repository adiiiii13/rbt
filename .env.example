# RBT Mission Learning — Env Template
# Copy to .env (gitignored) and fill real values.
# Vite exposes only VITE_-prefixed vars to client bundle — never put real secrets here.

# Firebase Web SDK (Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Cloud Messaging (Project Settings -> Cloud Messaging -> Web config -> Generate key pair)
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# Razorpay key_id (Razorpay Dashboard -> Settings -> API Keys)
# key_id is public-safe to bundle. key_secret stays in Cloud Functions env only.
VITE_RAZORPAY_KEY=rzp_live_xxxxxxxxx

# UPI ID for manual payment fallback
VITE_UPI_ID=yourupi@bank

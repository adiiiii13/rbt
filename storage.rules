rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function isAdminEmail() {
      return isSignedIn() && request.auth.token.email != null
        && request.auth.token.email.matches('.*@rbtmission[.]com');
    }
    function isAdmin()    { return isSignedIn() && (request.auth.token.role == 'admin' || isAdminEmail()); }
    function isStudent()  { return isSignedIn() && request.auth.token.role == 'student'; }
    function sizeOk(maxMB) { return request.resource.size < maxMB * 1024 * 1024; }
    function isImage()    { return request.resource.contentType.matches('image/.*'); }
    function isPdf()      { return request.resource.contentType == 'application/pdf'; }
    function isVideo()    { return request.resource.contentType.matches('video/.*'); }

    // GLOBAL ADMIN OVERRIDE - Admin has absolute power over everything
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Public marketing assets (gallery, course thumbs, achievements photos)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && sizeOk(10);
    }

    // PDFs for enrolled students
    match /pdfs/{file} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isPdf() && sizeOk(50);
    }

    // Video uploads (admin only — prefer external host for real videos)
    match /videos/{file} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isVideo() && sizeOk(500);
    }

    // Mock test question images (admin uploads, all signed-in users read)
    match /mockTestImages/{file} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isImage() && sizeOk(5);
    }

    // Study material — folders/videos/images/PDFs (admin write, signed-in read)
    match /studyMaterial/{file} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && (isImage() || isPdf() || isVideo())
        && sizeOk(500);
    }

    // Per-student private files (id proof, photos, payment screenshots)
    match /students/{uid}/{file} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if (isAdmin() || (isSignedIn() && request.auth.uid == uid))
        && (isImage() || isPdf()) && sizeOk(5);
    }

    // Doubt photos — any signed-in user uploads under own uid; signed-in read for admin reply view
    match /doubts/{uid}/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid
        && isImage() && sizeOk(5);
    }

    // Default deny
    match /{allPaths=**} { allow read, write: if false; }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // Admin domain fallback — Google sign-in does not get custom claim
    // without Cloud Function. Match by verified @rbtmission.com email.
    function isAdminEmail() {
      return isSignedIn() && request.auth.token.email != null
        && request.auth.token.email.matches('.*@rbtmission[.]com');
    }
    function isAdmin() {
      return isSignedIn() && (request.auth.token.role == 'admin' || isAdminEmail());
    }
    function isStudent() {
      return isSignedIn() && request.auth.token.role == 'student';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // GLOBAL ADMIN OVERRIDE - Admin has absolute power over everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Public read content; admin write only
    match /courses/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /videos/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /achievements/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /notices/{doc}      { allow read: if true; allow write: if isAdmin(); }

    // PDFs: public read; admin write
    match /pdfs/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mock Tests: public read; admin write
    match /mockTests/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mock Attempts: student create own; admin read all; student read own
    match /mockAttempts/{doc} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Study Material: public read; admin write
    match /studyMaterial/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications: admin write; student read own
    match /notifications/{doc} {
      allow create: if isAdmin();
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Doubts: student create own; admin read all; student read own; admin update for reply
    match /doubts/{doc} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Students: admin full access; signed-in user creates own doc
    match /students/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create: if isAdmin() || (isOwner(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.email == request.auth.token.email);
      allow update: if isAdmin() || (isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role','studentId','createdAt']));
      allow delete: if isAdmin();
    }

    // Counselling: anyone create; signed-in read; admin full
    match /counsellingBookings/{doc} {
      allow create: if request.resource.data.studentName is string
        && request.resource.data.studentName.size() < 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 20
        && request.resource.data.keys().size() < 20;
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Inquiries: anyone create; admin read/delete
    match /inquiries/{doc} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() < 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 20
        && request.resource.data.keys().size() < 15;
      allow read, update, delete: if isAdmin();
    }

    // Payments: student create own; admin read/update all; student read own
    match /payments/{doc} {
      allow create: if isStudent();
      allow read: if isAdmin() || isStudent();
      allow update, delete: if isAdmin();
    }

    // Enrollments: student read own; admin full access
    match /enrollments/{doc} {
      allow create: if isStudent() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Invoices: read for owner student + admin; admin writes
    match /invoices/{doc} {
      allow read: if isAdmin() || isStudent();
      allow write: if isAdmin();
    }

    // Razorpay Orders: owner read/create; admin full
    match /razorpayOrders/{doc} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Offers: public read; admin write
    match /offers/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course-specific doubts: student create own; admin read all; student read own; admin update for answer
    match /courseDoubts/{doc} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Course-specific inquiries
    match /courseInquiries/{doc} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Course-specific issue reports
    match /courseReports/{doc} {
      allow create: if isSignedIn();
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Guest access codes: admin only
    match /guestCodes/{doc} {
      allow read, write: if isAdmin();
    }

    // Deleted IDs tracking: admin only
    match /_deleted/{doc} {
      allow read, write: if isAdmin();
    }

    // Batches: public read; admin write
    match /batches/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings: public read; admin write
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
